# ============================================================
# Discord Bot 环境变量模板
# 使用方法：把本文件复制一份改名为 .env，然后填入真实值
# 注意：.env 已被 .gitignore 忽略，不会被上传到 GitHub
# ============================================================

# ---------- Discord ----------
# Bot Token（Discord Developer Portal → Bot → Reset Token 获取）
DISCORD_TOKEN=在这里填入你的BotToken

# Application ID / Client ID（Discord Developer Portal → General Information）
DISCORD_CLIENT_ID=1551412653367369738

# ---------- AI（推荐 DeepSeek，接口兼容 OpenAI）----------
# DeepSeek 控制台：https://platform.deepseek.com/api_keys
AI_API_KEY=在这里填入你的DeepSeekKey
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3

# ---------- Supabase ----------
# 只填到项目主页地址即可，末尾不要带 /rest/v1/
SUPABASE_URL=https://lkgkqaqhxitpkemekgre.supabase.co
SUPABASE_SERVICE_KEY=在这里填入service_role密钥

# ---------- 业务配置 ----------
# 要监控的频道 ID，多个用英文逗号分隔（以后加频道就改这里）
TRACK_CHANNEL_IDS=1419607085821333634

# 需要重点关注的成员（用户名或昵称），多个用逗号分隔；留空表示不特别高亮
WATCH_MEMBERS=

# 触发总结的命令名（默认 check，即 /check）
CHECK_COMMAND_NAME=check

# 【重要】允许使用 /check 的 Discord 用户 ID，多个用英文逗号分隔
# 留空 = 服务器里所有人都能用（启动日志会警告）
# 获取方法：Discord 设置 → 高级 → 打开开发者模式 → 右键该用户 → 复制用户 ID
# 示例：ALLOWED_USER_IDS=1362424024243634176
ALLOWED_USER_IDS=

# 机器人回复和 AI 总结使用的语言：Chinese（默认）/ English
SUMMARY_LANGUAGE=Chinese

# 时区（影响总结里显示的时间）
TIMEZONE=Asia/Shanghai

# 消息保留天数，0 表示永久保留（建议 90）
RETENTION_DAYS=90

# 单次总结最多读取多少条消息
MAX_SUMMARY_MESSAGES=3000

# ---------- 本地调试（Render 上不用改）----------
# PORT=3000
